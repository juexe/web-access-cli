# Deployment template for the DeepSeek-compatible gateway.
#
# Copy this file to a non-committed path (for this repo: personal/deploy.env), fill in real values, and never commit
# the result. All variables are optional; the defaults below match compose.yaml.
#
# WEB_ACCESS_IMAGE=web-access-cli:local
# WEB_ACCESS_BIND=127.0.0.1:18180
# WEB_ACCESS_SECRET_PROVIDER_CONFIG=../personal/secrets/provider-config.json
# WEB_ACCESS_SECRET_GATEWAY_KEY=../personal/secrets/gateway-api-key
