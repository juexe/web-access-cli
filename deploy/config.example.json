{
	"$schema": "https://unpkg.com/web-access-cli@0.6.0/schemas/config.schema.json",
	"providers": [
		{ "id": "anysearch", "type": "anysearch", "apiKey": "<ANYSEARCH_API_KEY>" },
		{ "id": "xcrawl", "type": "xcrawl", "apiKey": "<XCRAWL_API_KEY>" },
		{ "id": "brave", "type": "brave", "apiKey": "<BRAVE_API_KEY>" },
		{ "id": "tavily", "type": "tavily", "apiKey": "<TAVILY_API_KEY>" },
		{ "id": "exa", "type": "exa", "apiKey": "<EXA_API_KEY>" },
		{ "id": "bocha", "type": "bocha", "apiKey": "<BOCHA_API_KEY>" },
		{ "id": "firecrawl", "type": "firecrawl", "apiKey": "<FIRECRAWL_API_KEY>" },
		{ "id": "jina", "type": "jina" }
	],
	"search": {
		"providers": ["anysearch", "xcrawl", "brave", "tavily", "exa", "bocha"],
		"providers_fallback": []
	},
	"extract": {
		"providers": ["firecrawl", "xcrawl", "anysearch", "exa", "jina"],
		"providers_fallback": ["http"]
	}
}
